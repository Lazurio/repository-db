{
  "name": "@lazurio/repository-db",
  "version": "0.1.0",
  "description": "Git-backed YAML repository database engine: local serverless data layer with typed collections, draft/publish flow and deterministic generated read models.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lazurio/repository-db.git"
  },
  "homepage": "https://github.com/Lazurio/repository-db#readme",
  "bugs": {
    "url": "https://github.com/Lazurio/repository-db/issues"
  },
  "keywords": [
    "git",
    "yaml",
    "database",
    "filesystem",
    "local-first",
    "repository"
  ],
  "bin": {
    "repository-db": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "cli": "bun run src/cli.ts"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "~5.9.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
